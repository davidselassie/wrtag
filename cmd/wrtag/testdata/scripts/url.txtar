exec tag write src/kat_moda/01.flac title 'alarms'
exec tag write src/kat_moda/02.flac title 'the bells'
exec tag write src/kat_moda/03.flac title 'the bells fesitival mix'
exec tag write src/kat_moda/*.flac musicbrainz_albumid 'e47d04a4-7460-427d-a731-cc82386d85f1'
exec touch src/kat_moda/cover.jpg
exec touch src/kat_moda/notes.txt

env WRTAG_PATH_FORMAT='albums/{{ .Release.Title | safepath }}/{{ pad0 2 .Track.Position }} {{ .Track.Title | safepath }}{{ .Ext }}'
env WRTAG_KEEP_FILE='notes.txt'

# a directory listing, which redirects to add the trailing slash
exec wrtag move -yes $SERVE_URL/src/kat_moda
exec find albums/
cmp stdout exp-layout
exec tag check 'albums/Kat Moda/02 The Bells.flac' title 'The Bells'

# the source is left alone, even for a move
exists src/kat_moda/01.flac

# a dry run writes nothing
rm albums
exec wrtag move -dry-run -yes $SERVE_URL/src/kat_moda/
! exists albums

# a zip archive
exec zip kat_moda.zip src/kat_moda
exec wrtag copy -yes $SERVE_URL/kat_moda.zip
exec find albums/
cmp stdout exp-layout
exists kat_moda.zip

# a single file is a release of one track
rm albums
! exec wrtag copy -yes $SERVE_URL/src/kat_moda/01.flac
stderr 'track count mismatch: 3 remote / 1 local'

# a missing release
! exec wrtag copy -yes $SERVE_URL/nope/
stderr '404 Not Found'

-- exp-layout --
albums
albums/Kat Moda
albums/Kat Moda/01 Alarms.flac
albums/Kat Moda/02 The Bells.flac
albums/Kat Moda/03 The Bells (Festival mix).flac
albums/Kat Moda/cover.jpg
albums/Kat Moda/notes.txt
